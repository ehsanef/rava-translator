{
  "manifest_version": 3,
  "name": "Rava — ترجمه به زبان خودت",
  "version": "1.2.0",
  "author": "Ehsanef",
  "description": "Select text, choose your voice, and translate naturally with your own Gemini API key. ترجمهٔ روان، خودمونی و توییتری.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Rava · راوا" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }],
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+Shift+T", "mac": "Alt+Shift+T" },
      "description": "Translate selected text with Rava"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://generativelanguage.googleapis.com; base-uri 'none';"
  }
}
